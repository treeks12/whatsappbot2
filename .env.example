TELEGRAM_BOT_TOKEN=123456789:token
TELEGRAM_ADMIN_IDS=

# Se TELEGRAM_ADMIN_IDS ficar vazio, o bot recusa iniciar (fail-closed).
# Defina true APENAS se realmente quiser qualquer usuario do Telegram com acesso.
ALLOW_OPEN_ACCESS=false

EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-aqui

DATABASE_PATH=/app/data/bot.sqlite3
CAMPAIGNS_DIR=/app/campaigns

MAX_CLIENTS_PER_CAMPAIGN=0
MAX_TRUSTED_CLIENTS_PER_CAMPAIGN=0
MAX_PRECAUTION_CLIENTS_PER_CAMPAIGN=0
MAX_MEDIA_PER_CAMPAIGN=5
MAX_MEDIA_FILE_MB=3
MAX_PARALLEL_MEDIA_UPLOADS=2
PROGRESS_UPDATE_INTERVAL_SECONDS=5
CLEANUP_CAMPAIGN_FILES_ON_FINISH=true
DEFAULT_PROFILE=precaucao_100

# Deixe vazio para permitir envio em qualquer horario.
# Exemplo para janela personalizada: 02:00-23:59
SEND_WINDOW=

# Pausa a campanha se a RAM livre do container cair abaixo deste valor.
MIN_FREE_MEMORY_MB=256
CONTACT_LIST_SNAPSHOT_KEEP=3
CONTACT_LIST_SNAPSHOT_DAYS=14

# Webhook que recebe eventos da Evolution (delivered/read/replied).
# WEBHOOK_PUBLIC_URL eh a URL que a Evolution chama (rede interna do Docker:
# use o nome do container do bot). O token vai na propria URL como camada
# adicional de auth, alem do isolamento da rede bot-net.
# WEBHOOK_AUTO_CONFIGURE=true pede pra cada instancia ja conectada ter o webhook
# configurado no boot do bot, e em /login.
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8090
# Se deixar WEBHOOK_TOKEN/WEBHOOK_PUBLIC_URL vazios, o bot gera um token
# estavel a partir da EVOLUTION_API_KEY e usa a URL interna do compose.
WEBHOOK_TOKEN=
WEBHOOK_PUBLIC_URL=
WEBHOOK_AUTO_CONFIGURE=true
